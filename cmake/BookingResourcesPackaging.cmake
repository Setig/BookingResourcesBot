include_guard(GLOBAL)

include(CPackComponent)

set(BOOKING_RESOURCES_PACKAGE_BASENAME "booking-resources-bot")
set(BOOKING_RESOURCES_PACKAGE_INSTALL_DIRECTORY "BookingResourcesBot")
set(BOOKING_RESOURCES_COMPONENT_COMMON "common")
set(BOOKING_RESOURCES_COMPONENT_SERVER "server")
set(BOOKING_RESOURCES_COMPONENT_WEB "web")
set(BOOKING_RESOURCES_COMPONENT_CLI "cli")
set(BOOKING_RESOURCES_PACKAGE_DOCDIR
    "${CMAKE_INSTALL_DATAROOTDIR}/doc/${BOOKING_RESOURCES_PACKAGE_BASENAME}")
set(BOOKING_RESOURCES_PACKAGE_SYSTEMD_UNITDIR
    "${CMAKE_INSTALL_LIBDIR}/systemd/system")
set(BOOKING_RESOURCES_PACKAGE_WINDOWSDIR
    "${CMAKE_INSTALL_DATAROOTDIR}/${BOOKING_RESOURCES_PACKAGE_BASENAME}/windows")
set(BOOKING_RESOURCES_SERVER_SETTINGS_ORGANIZATION "BookingResourcesBot-Server")
set(BOOKING_RESOURCES_SERVER_SETTINGS_APPLICATION "config")
set(BOOKING_RESOURCES_WEB_SETTINGS_ORGANIZATION "BookingResourcesBot-Web")
set(BOOKING_RESOURCES_WEB_SETTINGS_APPLICATION "web")
set(BOOKING_RESOURCES_WINDOWS_SERVICE_NAME_SERVER "BookingResourcesBotServer")
set(BOOKING_RESOURCES_WINDOWS_SERVICE_NAME_WEB "BookingResourcesBotWeb")
set(BOOKING_RESOURCES_WEB_SHARED_MEMORY_KEY "booking-resources-web")
set(BOOKING_RESOURCES_PACKAGING_BINARY_DIR
    "${CMAKE_CURRENT_BINARY_DIR}/booking-resources-packaging")

if(WIN32)
  set(BOOKING_RESOURCES_PACKAGE_STATEDIR
      "C:/ProgramData/${BOOKING_RESOURCES_PACKAGE_INSTALL_DIRECTORY}/data")
  set(BOOKING_RESOURCES_PACKAGE_LOGDIR
      "C:/ProgramData/${BOOKING_RESOURCES_PACKAGE_INSTALL_DIRECTORY}/log")
elseif(UNIX AND NOT APPLE)
  set(BOOKING_RESOURCES_PACKAGE_STATEDIR
      "${CMAKE_INSTALL_LOCALSTATEDIR}/lib/${BOOKING_RESOURCES_PACKAGE_BASENAME}")
  set(BOOKING_RESOURCES_PACKAGE_LOGDIR
      "${CMAKE_INSTALL_LOCALSTATEDIR}/log/${BOOKING_RESOURCES_PACKAGE_BASENAME}")
endif()

file(MAKE_DIRECTORY "${BOOKING_RESOURCES_PACKAGING_BINARY_DIR}")

set(_br_server_system_config
    "${BOOKING_RESOURCES_PACKAGING_BINARY_DIR}/${BOOKING_RESOURCES_SERVER_SETTINGS_APPLICATION}.ini")
set(_br_web_system_config
    "${BOOKING_RESOURCES_PACKAGING_BINARY_DIR}/${BOOKING_RESOURCES_WEB_SETTINGS_APPLICATION}.ini")
configure_file("${PROJECT_SOURCE_DIR}/packaging/config/server-config.ini.in"
               "${_br_server_system_config}" @ONLY)
configure_file("${PROJECT_SOURCE_DIR}/packaging/config/web-config.ini.in"
               "${_br_web_system_config}" @ONLY)

install(FILES
  "${PROJECT_SOURCE_DIR}/README.md"
  DESTINATION "${BOOKING_RESOURCES_PACKAGE_DOCDIR}"
  COMPONENT "${BOOKING_RESOURCES_COMPONENT_COMMON}"
)

install(FILES
  "${PROJECT_SOURCE_DIR}/docs/docs.md"
  DESTINATION "${BOOKING_RESOURCES_PACKAGE_DOCDIR}/docs"
  COMPONENT "${BOOKING_RESOURCES_COMPONENT_COMMON}"
)

install(DIRECTORY
  "${PROJECT_SOURCE_DIR}/docs/en"
  "${PROJECT_SOURCE_DIR}/docs/ru"
  DESTINATION "${BOOKING_RESOURCES_PACKAGE_DOCDIR}/docs"
  COMPONENT "${BOOKING_RESOURCES_COMPONENT_COMMON}"
  FILES_MATCHING
    PATTERN "*.md"
)

if(WIN32)
  set(_br_server_windows_xml
      "${BOOKING_RESOURCES_PACKAGING_BINARY_DIR}/${BOOKING_RESOURCES_WINDOWS_SERVICE_NAME_SERVER}.xml")
  set(_br_web_windows_xml
      "${BOOKING_RESOURCES_PACKAGING_BINARY_DIR}/${BOOKING_RESOURCES_WINDOWS_SERVICE_NAME_WEB}.xml")
  set(_br_server_windows_install_script
      "${BOOKING_RESOURCES_PACKAGING_BINARY_DIR}/install-${BOOKING_RESOURCES_PACKAGE_BASENAME}-server-service.ps1")
  set(_br_web_windows_install_script
      "${BOOKING_RESOURCES_PACKAGING_BINARY_DIR}/install-${BOOKING_RESOURCES_PACKAGE_BASENAME}-web-service.ps1")

  configure_file("${PROJECT_SOURCE_DIR}/packaging/windows/BookingResourcesBotServer.xml.in"
                 "${_br_server_windows_xml}" @ONLY)
  configure_file("${PROJECT_SOURCE_DIR}/packaging/windows/BookingResourcesBotWeb.xml.in"
                 "${_br_web_windows_xml}" @ONLY)
  configure_file(
    "${PROJECT_SOURCE_DIR}/packaging/windows/install-booking-resources-bot-server-service.ps1.in"
    "${_br_server_windows_install_script}" @ONLY)
  configure_file(
    "${PROJECT_SOURCE_DIR}/packaging/windows/install-booking-resources-bot-web-service.ps1.in"
    "${_br_web_windows_install_script}" @ONLY)

  install(FILES
    "${_br_server_system_config}"
    DESTINATION "${BOOKING_RESOURCES_PACKAGE_WINDOWSDIR}/system-scope/${BOOKING_RESOURCES_SERVER_SETTINGS_ORGANIZATION}"
    RENAME "${BOOKING_RESOURCES_SERVER_SETTINGS_APPLICATION}.ini"
    COMPONENT "${BOOKING_RESOURCES_COMPONENT_SERVER}"
  )

  install(FILES
    "${_br_web_system_config}"
    DESTINATION "${BOOKING_RESOURCES_PACKAGE_WINDOWSDIR}/system-scope/${BOOKING_RESOURCES_WEB_SETTINGS_ORGANIZATION}"
    RENAME "${BOOKING_RESOURCES_WEB_SETTINGS_APPLICATION}.ini"
    COMPONENT "${BOOKING_RESOURCES_COMPONENT_WEB}"
  )

  install(FILES
    "${_br_server_windows_xml}"
    "${_br_server_windows_install_script}"
    DESTINATION "${BOOKING_RESOURCES_PACKAGE_WINDOWSDIR}/server"
    COMPONENT "${BOOKING_RESOURCES_COMPONENT_SERVER}"
  )

  install(FILES
    "${_br_web_windows_xml}"
    "${_br_web_windows_install_script}"
    DESTINATION "${BOOKING_RESOURCES_PACKAGE_WINDOWSDIR}/web"
    COMPONENT "${BOOKING_RESOURCES_COMPONENT_WEB}"
  )
elseif(UNIX AND NOT APPLE)
  set(_br_server_systemd_unit
      "${BOOKING_RESOURCES_PACKAGING_BINARY_DIR}/booking-resources-bot-server.service")
  set(_br_web_systemd_unit
      "${BOOKING_RESOURCES_PACKAGING_BINARY_DIR}/booking-resources-bot-web.service")

  configure_file(
    "${PROJECT_SOURCE_DIR}/packaging/linux/systemd/booking-resources-bot-server.service.in"
    "${_br_server_systemd_unit}" @ONLY)
  configure_file(
    "${PROJECT_SOURCE_DIR}/packaging/linux/systemd/booking-resources-bot-web.service.in"
    "${_br_web_systemd_unit}" @ONLY)

  install(FILES
    "${_br_server_system_config}"
    DESTINATION "${CMAKE_INSTALL_SYSCONFDIR}/xdg/${BOOKING_RESOURCES_SERVER_SETTINGS_ORGANIZATION}"
    RENAME "${BOOKING_RESOURCES_SERVER_SETTINGS_APPLICATION}.ini"
    COMPONENT "${BOOKING_RESOURCES_COMPONENT_SERVER}"
  )

  install(FILES
    "${_br_web_system_config}"
    DESTINATION "${CMAKE_INSTALL_SYSCONFDIR}/xdg/${BOOKING_RESOURCES_WEB_SETTINGS_ORGANIZATION}"
    RENAME "${BOOKING_RESOURCES_WEB_SETTINGS_APPLICATION}.ini"
    COMPONENT "${BOOKING_RESOURCES_COMPONENT_WEB}"
  )

  install(FILES
    "${_br_server_systemd_unit}"
    DESTINATION "${BOOKING_RESOURCES_PACKAGE_SYSTEMD_UNITDIR}"
    COMPONENT "${BOOKING_RESOURCES_COMPONENT_SERVER}"
  )

  install(FILES
    "${_br_web_systemd_unit}"
    DESTINATION "${BOOKING_RESOURCES_PACKAGE_SYSTEMD_UNITDIR}"
    COMPONENT "${BOOKING_RESOURCES_COMPONENT_WEB}"
  )
endif()

set(CPACK_PACKAGE_NAME "${BOOKING_RESOURCES_PACKAGE_BASENAME}")
set(CPACK_PACKAGE_VENDOR "Booking Resources Bot")
set(CPACK_PACKAGE_CONTACT "Booking Resources Bot")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Booking Resources Bot")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_INSTALL_DIRECTORY "${BOOKING_RESOURCES_PACKAGE_INSTALL_DIRECTORY}")
set(CPACK_VERBATIM_VARIABLES YES)
set(CPACK_MONOLITHIC_INSTALL OFF)
set(CPACK_COMPONENTS_ALL
    "${BOOKING_RESOURCES_COMPONENT_COMMON};${BOOKING_RESOURCES_COMPONENT_SERVER};${BOOKING_RESOURCES_COMPONENT_WEB};${BOOKING_RESOURCES_COMPONENT_CLI}")

cpack_add_component("${BOOKING_RESOURCES_COMPONENT_COMMON}"
  DISPLAY_NAME "Common"
  DESCRIPTION "Common documentation and packaging metadata."
  REQUIRED
)

cpack_add_component("${BOOKING_RESOURCES_COMPONENT_SERVER}"
  DISPLAY_NAME "Server"
  DESCRIPTION "Booking Resources Bot server process."
  DEPENDS "${BOOKING_RESOURCES_COMPONENT_COMMON}"
)

cpack_add_component("${BOOKING_RESOURCES_COMPONENT_WEB}"
  DISPLAY_NAME "Web"
  DESCRIPTION "Booking Resources Bot web process."
  DEPENDS "${BOOKING_RESOURCES_COMPONENT_COMMON}"
)

cpack_add_component("${BOOKING_RESOURCES_COMPONENT_CLI}"
  DISPLAY_NAME "CLI"
  DESCRIPTION "Booking Resources Bot local CLI."
  DEPENDS "${BOOKING_RESOURCES_COMPONENT_COMMON}"
)

if(WIN32)
  find_program(BOOKING_RESOURCES_WIX_COMMAND NAMES wix)
  find_program(BOOKING_RESOURCES_WIX_CANDLE_COMMAND NAMES candle)
  find_program(BOOKING_RESOURCES_WIX_LIGHT_COMMAND NAMES light)
  find_program(BOOKING_RESOURCES_NSIS_COMMAND NAMES makensis)
  find_program(BOOKING_RESOURCES_WINDEPLOYQT_EXECUTABLE NAMES windeployqt)

  if(BOOKING_RESOURCES_WIX_COMMAND
     OR (BOOKING_RESOURCES_WIX_CANDLE_COMMAND AND BOOKING_RESOURCES_WIX_LIGHT_COMMAND))
    set(CPACK_GENERATOR "WIX;ZIP")
  elseif(BOOKING_RESOURCES_NSIS_COMMAND)
    set(CPACK_GENERATOR "NSIS;ZIP")
  else()
    set(CPACK_GENERATOR "ZIP")
  endif()

  set(CPACK_ARCHIVE_COMPONENT_INSTALL ON)

  if(BOOKING_RESOURCES_WINDEPLOYQT_EXECUTABLE)
    install(CODE
      "set(BOOKING_RESOURCES_WINDEPLOYQT_EXECUTABLE [[${BOOKING_RESOURCES_WINDEPLOYQT_EXECUTABLE}]])\nset(BOOKING_RESOURCES_WINDOWS_DEPLOY_BINDIR [[${CMAKE_INSTALL_BINDIR}]])\nset(BOOKING_RESOURCES_WINDOWS_DEPLOY_EXECUTABLES [[booking-resources-server.exe;booking-resources-web.exe;booking-resources-cli.exe]])\ninclude([[${CMAKE_CURRENT_LIST_DIR}/BookingResourcesWindowsDeploy.cmake]])"
      COMPONENT "${BOOKING_RESOURCES_COMPONENT_COMMON}"
    )
  else()
    message(WARNING "windeployqt was not found in PATH; Windows packages will not bundle Qt runtime dependencies automatically.")
  endif()
elseif(UNIX AND NOT APPLE)
  set(CPACK_GENERATOR "DEB;RPM")
  set(CPACK_DEB_COMPONENT_INSTALL ON)
  set(CPACK_RPM_COMPONENT_INSTALL ON)
  set(CPACK_DEBIAN_FILE_NAME "DEB-DEFAULT")
  set(CPACK_RPM_FILE_NAME "RPM-DEFAULT")
  set(CPACK_DEBIAN_PACKAGE_MAINTAINER "Booking Resources Bot")
  set(CPACK_RPM_PACKAGE_LICENSE "Proprietary")
  set(CPACK_RPM_PACKAGE_AUTOREQ ON)

  set(CPACK_DEBIAN_COMMON_PACKAGE_NAME
      "${BOOKING_RESOURCES_PACKAGE_BASENAME}-common")
  set(CPACK_DEBIAN_SERVER_PACKAGE_NAME
      "${BOOKING_RESOURCES_PACKAGE_BASENAME}-server")
  set(CPACK_DEBIAN_WEB_PACKAGE_NAME
      "${BOOKING_RESOURCES_PACKAGE_BASENAME}-web")
  set(CPACK_DEBIAN_CLI_PACKAGE_NAME
      "${BOOKING_RESOURCES_PACKAGE_BASENAME}-cli")

  set(CPACK_RPM_COMMON_PACKAGE_NAME
      "${BOOKING_RESOURCES_PACKAGE_BASENAME}-common")
  set(CPACK_RPM_SERVER_PACKAGE_NAME
      "${BOOKING_RESOURCES_PACKAGE_BASENAME}-server")
  set(CPACK_RPM_WEB_PACKAGE_NAME
      "${BOOKING_RESOURCES_PACKAGE_BASENAME}-web")
  set(CPACK_RPM_CLI_PACKAGE_NAME
      "${BOOKING_RESOURCES_PACKAGE_BASENAME}-cli")

  set(CPACK_DEBIAN_SERVER_PACKAGE_DEPENDS
      "${BOOKING_RESOURCES_PACKAGE_BASENAME}-common")
  set(CPACK_DEBIAN_WEB_PACKAGE_DEPENDS
      "${BOOKING_RESOURCES_PACKAGE_BASENAME}-common")
  set(CPACK_DEBIAN_CLI_PACKAGE_DEPENDS
      "${BOOKING_RESOURCES_PACKAGE_BASENAME}-common")

  set(CPACK_RPM_SERVER_PACKAGE_REQUIRES
      "${BOOKING_RESOURCES_PACKAGE_BASENAME}-common")
  set(CPACK_RPM_WEB_PACKAGE_REQUIRES
      "${BOOKING_RESOURCES_PACKAGE_BASENAME}-common")
  set(CPACK_RPM_CLI_PACKAGE_REQUIRES
      "${BOOKING_RESOURCES_PACKAGE_BASENAME}-common")

  set(CPACK_DEBIAN_SERVER_PACKAGE_SHLIBDEPS ON)
  set(CPACK_DEBIAN_WEB_PACKAGE_SHLIBDEPS ON)
  set(CPACK_DEBIAN_CLI_PACKAGE_SHLIBDEPS ON)
else()
  set(CPACK_GENERATOR "TGZ")
endif()
