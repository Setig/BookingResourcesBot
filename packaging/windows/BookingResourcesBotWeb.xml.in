<service>
  <id>@BOOKING_RESOURCES_WINDOWS_SERVICE_NAME_WEB@</id>
  <name>Booking Resources Bot Web</name>
  <description>Booking Resources Bot web process.</description>
  <executable>%BASE%\bin\booking-resources-web.exe</executable>
  <workingdirectory>%BASE%\bin</workingdirectory>
  <log mode="roll-by-size">
    <sizeThreshold>10485760</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
</service>
